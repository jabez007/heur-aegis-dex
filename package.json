{
  "name": "@jabez007/heur-aegis-dex",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/heur-aegis-dex.cjs",
  "module": "lib/heur-aegis-dex.es.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "CHANGELOG.md",
    "LICENSE",
    "data/POKEAPI-NOTICE.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/heur-aegis-dex.es.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/heur-aegis-dex.cjs"
      }
    },
    "./style.css": "./lib/heur-aegis-dex.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "jabez007",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabez007/heur-aegis-dex.git"
  },
  "homepage": "https://github.com/jabez007/heur-aegis-dex#readme",
  "bugs": {
    "url": "https://github.com/jabez007/heur-aegis-dex/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build:lib",
    "predeploy": "npm run build",
    "deploy": "push-dir --dir=dist --branch=main --cleanup",
    "check:browser": "bash scripts/check-browser-bundle.sh",
    "check:package": "node scripts/check-package.mjs",
    "test:browser:offline": "npm run build && playwright test",
    "check:regulations": "tsx scripts/check-regulation-freshness.mjs",
    "gen:pokemon-catalog": "tsx scripts/generate-pokemon-catalog.ts",
    "gen:coverage-moves": "node scripts/gen-coverage-moves.mjs",
    "gen:scoring-fixture": "tsx scripts/gen-scoring-fixture.mjs",
    "measure:alternative-margin": "tsx scripts/measure-alternative-margin.mjs",
    "measure:composite-bounds": "tsx scripts/measure-composite-bounds.mjs",
    "measure:damage-bounds": "tsx scripts/measure-damage-bounds.mjs",
    "measure:stab-power": "tsx scripts/measure-stab-power.mjs",
    "measure:status-threat": "tsx scripts/measure-status-threat.mjs",
    "measure:support-eligibility": "tsx scripts/measure-support-eligibility.mjs",
    "measure:usage-correlation": "tsx scripts/measure-usage-correlation.mjs"
  },
  "dependencies": {
    "lscache": "^1.3.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "^1.54.1",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "pokedex-promise-v2": "^4.2.3",
    "push-dir": "^0.4.1",
    "sass": "^1.99.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.9"
  }
}
